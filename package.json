{
  "name": "teams-transcript-to-markdown",
  "version": "1.0.0",
  "description": "Converts Microsoft Teams transcript .docx exports into structured Markdown notes for Obsidian and Claude.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian-plugin",
    "microsoft-teams",
    "transcript",
    "markdown"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.19.11",
    "obsidian": "latest",
    "tslib": "2.6.2",
    "typescript": "5.3.3"
  },
  "dependencies": {
    "mammoth": "^1.7.0"
  }
}
